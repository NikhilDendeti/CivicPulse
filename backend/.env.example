# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Postgres in production (SQLite is used when unset)
# DATABASE_URL=postgres://civicpulse:civicpulse@localhost:5432/civicpulse

# Optional: Celery + Redis. Without it the pipeline runs in a background thread.
# CELERY_BROKER_URL=redis://localhost:6379/0

# AI providers
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small
SARVAM_API_KEY=
# Verify current model names in the Sarvam docs
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TRANSLATE_MODEL=mayura:v1

# Dispatch: sandbox sends every complaint to SANDBOX_EMAIL; live sends to VERIFIED authority channels only.
DISPATCH_MODE=sandbox
SANDBOX_EMAIL=
DEFAULT_FROM_EMAIL=CivicPulse <noreply@example.org>
# Leave EMAIL_HOST empty to print emails to the console in dev.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Identify yourself to OpenStreetMap's Nominatim (required by its usage policy)
NOMINATIM_USER_AGENT=CivicPulse-Forge/0.1 (contact: you@example.org)

CONFIDENCE_THRESHOLD=0.5
DUPLICATE_RADIUS_M=60
DUPLICATE_SIMILARITY=0.80
ACK_WINDOW_HOURS=48
CRITICAL_ACK_WINDOW_HOURS=6
MAX_AUDIO_SECONDS=30
